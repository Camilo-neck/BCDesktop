{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BetterCampus",
  "version": "0.2.0",
  "identifier": "co.com.bettercampus.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BetterCampus",
        "width": 1360,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "backgroundColor": "#111411"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob: https://*.googleusercontent.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Planeador de horarios para la UNAL",
    "longDescription": "BetterCampus arma tu horario con la oferta del SIA, genera combinaciones sin choques, analiza tu historia académica y muestra el mapa de prerrequisitos de tu plan. Todo se calcula en tu equipo.",
    "copyright": "© BetterCampus",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "section": "education" },
      "rpm": { "release": "1" }
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4RTNGNkYwMEUzQTI5RjIKUldUeUtUb084UGJqU0FrVVZlMmFxblV6ZzBWbFNHU21HRFJiQk1wZ1RhaWJDUmhkV2xZblZrVWMK",
      "endpoints": ["https://github.com/Camilo-neck/BCDesktop/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
