# Variables de compilación para builds locales. Copia este archivo como `.env` (ignorado por git)
# y completa lo que necesites; los valores vacíos se ignoran. En CI se configuran como variables
# y secrets de GitHub Actions (ver docs/RELEASING.md).

# Cliente OAuth «App de escritorio» de Google Cloud, para exportar a Google Calendar.
BC_GOOGLE_CLIENT_ID=
BC_GOOGLE_CLIENT_SECRET=

# URL base de la API de estadísticas de cupos.
BC_STATS_API_URL=
